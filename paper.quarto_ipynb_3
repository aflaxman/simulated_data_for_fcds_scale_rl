        "#| label: population-descriptives\n",
        "comp = pd.read_csv(\"results/registry_age_sex.csv\")\n",
        "fold = {\"Multiracial or Other\": \"Other\", \"AIAN\": \"Other\", \"NHOPI\": \"Other\", \"Unknown\": \"Other\"}\n",
        "comp[\"race\"] = comp[\"race_ethnicity\"].map(lambda r: fold.get(r, r if r in (\"White\", \"Latino\", \"Black\", \"Asian\") else \"Other\"))\n",
        "\n",
        "def share(file, mask):\n",
        "    g = comp[comp[\"file\"] == file]\n",
        "    return g[mask(g)][\"count\"].sum() / g[\"count\"].sum()\n",
        "\n",
        "def race_shares(file):\n",
        "    g = comp[comp[\"file\"] == file].groupby(\"race\")[\"count\"].sum()\n",
        "    return (g / g.sum()).reindex([\"White\", \"Latino\", \"Black\", \"Asian\", \"Other\"]).fillna(0)\n",
        "\n",
        "female_reg, female_500k = pct(share(\"registry.csv\", lambda g: g.sex == \"Female\"), 0), pct(share(\"finder_500k.csv\", lambda g: g.sex == \"Female\"), 0)\n",
        "over65_reg, over65_500k = pct(share(\"registry.csv\", lambda g: g.age_start >= 65), 0), pct(share(\"finder_500k.csv\", lambda g: g.age_start >= 65), 0)\n",
        "under40_reg, under40_500k = pct(share(\"registry.csv\", lambda g: g.age_start < 40), 0), pct(share(\"finder_500k.csv\", lambda g: g.age_start < 40), 0)\n",
        "race_reg = {k: pct(v, 0) for k, v in race_shares(\"registry.csv\").items()}\n",
        "race_500k = {k: pct(v, 0) for k, v in race_shares(\"finder_500k.csv\").items()}\n",
        "\n",
        "# the two finder files, compared on every share quoted in this section\n",
        "_shares = lambda f: pd.concat([race_shares(f), pd.Series({\"female\": share(f, lambda g: g.sex == \"Female\"),\n",
        "                                                          \"over65\": share(f, lambda g: g.age_start >= 65),\n",
        "                                                          \"under40\": share(f, lambda g: g.age_start < 40)})])\n",
        "finder_files_max_diff_pp = f\"{100 * (_shares('finder_500k.csv') - _shares('finder_100k.csv')).abs().max():.1f}\"\n",
        "\n",
        "top = pd.read_csv(\"results/registry_top_names.csv\")\n",
        "top = top[top[\"file\"] == \"registry.csv\"]\n",
        "def top3(sex, group):\n",
        "    return \", \".join(top[(top.sex == sex) & (top.age_group == group)].sort_values(\"rank\")[\"first_name\"])\n",
        "boys_0_4, men_85 = top3(\"Male\", \"0–4\"), top3(\"Male\", \"85+\")\n",
        "girls_0_4, women_85 = top3(\"Female\", \"0–4\"), top3(\"Female\", \"85+\")\n",
        "share_2020, share_2030, share_2040 = (pct(by_year[y] / sum(by_year.values()), 0) for y in (\"2020\", \"2030\", \"2040\"))"
      ],
      "id": "population-descriptives",
