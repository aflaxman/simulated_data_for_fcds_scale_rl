        "#| label: load-summaries\n",
        "# Small committed summaries written by pipeline/build_cohorts.py, plus the design\n",
        "# targets from config.yaml. Every number in the prose below is one of these\n",
        "# variables; nothing is typed by hand.\n",
        "import json\n",
        "import pandas as pd\n",
        "import yaml\n",
        "pop      = json.load(open(\"results/population_summary.json\"))\n",
        "manifest = json.load(open(\"results/release_manifest.json\"))\n",
        "cfg      = yaml.safe_load(open(\"config.yaml\"))\n",
        "\n",
        "def n(x):\n",
        "    return f\"{int(x):,}\"\n",
        "\n",
        "fl_pool             = n(pop[\"fl_pool_last_seen\"])       # every simulant ever recorded in Florida, once\n",
        "fl_finder_pool      = n(pop[\"fl_residents_finder_year\"])\n",
        "finder_year         = pop[\"finder_year\"]\n",
        "fl_simulants        = n(pop[\"fl_simulants\"])            # 2020 census residents, for the official-count check\n",
        "registry_rows       = n(manifest[\"files\"][\"registry.csv\"][\"rows\"])\n",
        "finder_500k_rows    = n(manifest[\"files\"][\"finder_500k.csv\"][\"rows\"])\n",
        "finder_100k_rows    = n(manifest[\"files\"][\"finder_100k.csv\"][\"rows\"])\n",
        "overlap_500k_target = n(cfg[\"cohorts\"][\"overlap_500k_target\"])\n",
        "overlap_100k_target = n(cfg[\"cohorts\"][\"overlap_100k_target\"])\n",
        "\n",
        "# The Key Features quote the design targets as facts about the files, which is\n",
        "# only honest while the build hits them exactly; fail the render otherwise.\n",
        "for k in (\"500k\", \"100k\"):\n",
        "    assert manifest[\"overlaps\"][f\"finder_{k}\"][\"overlap_simulants\"] == cfg[\"cohorts\"][f\"overlap_{k}_target\"]\n",
        "assert manifest[\"overlaps\"][\"finder_finder_simulants\"] == cfg[\"cohorts\"][\"overlap_finder_finder_target\"]\n",
        "\n",
        "# --- everything else the prose quotes, named as in OUTLINE.md's computed-values table ---\n",
        "err   = json.load(open(\"results/error_rates.json\"))[\"realised\"]\n",
        "lb    = json.load(open(\"results/linkage_baseline.json\"))\n",
        "pairs = json.load(open(\"results/pair_agreement.json\"))[\"finder_500k.csv\"]\n",
        "qa    = json.load(open(\"results/age_sex_qa.json\"))[\"registry.csv\"]\n",
        "env   = json.load(open(\"results/environment.json\"))\n",
        "fcds  = pd.read_csv(cfg[\"paths\"][\"age_sex_target\"], comment=\"#\")\n",
        "\n",
        "def pct(x, d=1):\n",
        "    return f\"{100 * x:.{d}f}%\"\n",
        "\n",
        "files, ov = manifest[\"files\"], manifest[\"overlaps\"]\n",
        "registry_simulants     = n(files[\"registry.csv\"][\"distinct_simulants\"])\n",
        "registry_dupe_rows     = manifest[\"registry_duplicate_rows\"]\n",
        "finder_500k_simulants  = n(files[\"finder_500k.csv\"][\"distinct_simulants\"])\n",
        "finder_100k_simulants  = n(files[\"finder_100k.csv\"][\"distinct_simulants\"])\n",
        "overlap_500k_simulants = n(ov[\"finder_500k\"][\"overlap_simulants\"])\n",
        "overlap_100k_simulants = n(ov[\"finder_100k\"][\"overlap_simulants\"])\n",
        "overlap_500k_pairs     = n(ov[\"finder_500k\"][\"true_pairs\"])\n",
        "overlap_100k_pairs     = n(ov[\"finder_100k\"][\"true_pairs\"])\n",
        "overlap_finder_finder  = ov[\"finder_finder_simulants\"]\n",
        "match_prevalence_500k  = round(ov[\"finder_500k\"][\"match_prevalence\"], 3)\n",
        "fl_share_census        = pct(pop[\"fl_share_census\"])\n",
        "pop_ssn_never          = pct(pop[\"pop_ssn_never\"], 2)\n",
        "registry_ssn_missing   = pct(err[\"registry.csv\"][\"ssn_missing\"], 2)\n",
        "finder_ssn_missing     = pct(err[\"finder_500k.csv\"][\"ssn_missing\"])\n",
        "err_ssn_transposed     = n(err[\"finder_500k.csv\"][\"ssn_transposed\"])\n",
        "size_registry_mb, size_finder500k_mb, size_finder100k_mb, size_zip_mb = (\n",
        "    f\"{files['registry.csv']['size_bytes'] / 1e6:.0f}\", f\"{files['finder_500k.csv']['size_bytes'] / 1e6:.0f}\",\n",
        "    f\"{files['finder_100k.csv']['size_bytes'] / 1e6:.0f}\", f\"{manifest['zip']['size_bytes'] / 1e6:.0f}\")\n",
        "md5_registry, md5_finder500k, md5_finder100k, md5_zip = (\n",
        "    files[\"registry.csv\"][\"md5\"], files[\"finder_500k.csv\"][\"md5\"], files[\"finder_100k.csv\"][\"md5\"], manifest[\"zip\"][\"md5\"])\n",
        "\n",
        "co, se, no = cfg[\"cohorts\"], cfg[\"seeds\"], cfg[\"noise\"]\n",
        "cfg_registry_target, cfg_finder_500k_target, cfg_finder_100k_target = n(co[\"registry_target\"]), n(co[\"finder_500k_target\"]), n(co[\"finder_100k_target\"])\n",
        "cfg_oversample = co[\"oversample\"]\n",
        "cfg_seed_sample, cfg_seed_registry, cfg_seed_finder, cfg_seed_postprocess = se[\"duckdb_sample\"], se[\"psp_registry\"], se[\"psp_finder\"], se[\"postprocess\"]\n",
        "cfg_finder_ssn_missing, cfg_finder_ssn_transposed, cfg_finder_address_missing = pct(no[\"finder\"][\"ssn_missing\"], 0), pct(no[\"finder\"][\"ssn_transposed\"], 0), pct(no[\"finder\"][\"address_missing\"], 0)\n",
        "cfg_registry_ssn_missing, cfg_registry_ssn_transposed, cfg_registry_address_missing = pct(no[\"registry\"][\"ssn_missing\"], 0), pct(no[\"registry\"][\"ssn_transposed\"], 0), pct(no[\"registry\"][\"address_missing\"], 0)\n",
        "\n",
        "# deterministic ladder on the 500k finder file (results/linkage_baseline.json)\n",
        "lb500  = lb[\"finder_files\"][\"finder_500k.csv\"]\n",
        "rules  = {r[\"rule\"]: r for r in lb500[\"rules\"]}\n",
        "def rule(name, key):\n",
        "    return round(rules[name][key], 4)\n",
        "r500_name_dob_precision, r500_name_dob_recall = rule(\"name_dob\", \"precision\"), rule(\"name_dob\", \"recall\")\n",
        "r500_name_dob_missed        = round(1 - rules[\"name_dob\"][\"recall\"], 4)\n",
        "r500_ssn_only_precision     = rule(\"ssn_only\", \"precision\")\n",
        "r500_ssn_only_missed        = round(1 - rules[\"ssn_only\"][\"recall\"], 4)\n",
        "r500_fcds_min_ssn_recall    = rule(\"fcds_min_ssn\", \"recall\")\n",
        "r500_fcds_min_monthyear_precision = rule(\"fcds_min_monthyear\", \"precision\")\n",
        "r500_fcds_min_monthyear_fp  = n(rules[\"fcds_min_monthyear\"][\"predicted_pairs\"] - round(rules[\"fcds_min_monthyear\"][\"recall\"] * lb500[\"true_pairs\"]))\n",
        "r500_fcds_either_recall, r500_fcds_either_precision = rule(\"fcds_min_either\", \"recall\"), rule(\"fcds_min_either\", \"precision\")\n",
        "r500_fcds_current_recall    = rule(\"fcds_current_dob_ssn\", \"recall\")\n",
        "r500_best_recall, r500_best_precision = rule(\"name_dob_or_ssn\", \"recall\"), rule(\"name_dob_or_ssn\", \"precision\")\n",
        "r500_best_missed            = round(1 - rules[\"name_dob_or_ssn\"][\"recall\"], 4)\n",
        "r500_lastname_dob_precision = rule(\"lastname_dob\", \"precision\")\n",
        "baseline_seconds_500k       = lb500[\"seconds\"]\n",
        "\n",
        "# agreement among true pairs (results/pair_agreement.json)\n",
        "pa = pairs[\"fields\"]\n",
        "agree_first_name_500k, blank_first_name_500k = pct(pa[\"first_name\"][\"agree_when_both_present\"]), pct(pa[\"first_name\"][\"blank_on_either_side\"])\n",
        "agree_last_name_500k,  blank_last_name_500k  = pct(pa[\"last_name\"][\"agree_when_both_present\"]), pct(pa[\"last_name\"][\"blank_on_either_side\"])\n",
        "agree_dob_500k,        blank_dob_500k        = pct(pa[\"date_of_birth\"][\"agree_when_both_present\"]), pct(pa[\"date_of_birth\"][\"blank_on_either_side\"])\n",
        "agree_street_name_500k, blank_street_name_500k = pct(pa[\"street_name\"][\"agree_when_both_present\"]), pct(pa[\"street_name\"][\"blank_on_either_side\"])\n",
        "agree_ssn_500k,        blank_ssn_500k        = pct(pa[\"ssn\"][\"agree_when_both_present\"]), pct(pa[\"ssn\"][\"blank_on_either_side\"])\n",
        "name_dob_all_agree_500k = pct(pairs[\"name_dob_all_agree\"])\n",
        "ssn_usable_500k         = pct(pairs[\"ssn_usable_and_agree\"])\n",
        "\n",
        "# age/sex QA, FCDS table facts, environment\n",
        "age_sex_max_dev     = round(qa[\"max_abs_share_deviation_pct\"], 3)\n",
        "by_year             = qa[\"rows_by_census_year\"]\n",
        "registry_share_2040 = pct(by_year[\"2040\"] / sum(by_year.values()), 0)\n",
        "fcds_rate_min, fcds_rate_max = round(fcds[\"rate\"].min(), 2), round(fcds[\"rate\"].max(), 2)\n",
        "duckdb_version, psp_version, dataset_version = env[\"duckdb\"], env[\"pseudopeople\"], manifest[\"version\"]\n",
        "build_wall_seconds, build_peak_gb = round(env[\"build_wall_seconds\"]), round(env[\"peak_rss_mb\"] / 1024, 1)\n",
        "run_twice = json.load(open(\"results/run_twice.json\"))\n",
        "assert run_twice[\"files_identical\"], \"the run-twice identity test failed; fix the pipeline before claiming reproducibility\""
      ],
      "id": "load-summaries",
      "execution_count": null,
      "outputs": []
