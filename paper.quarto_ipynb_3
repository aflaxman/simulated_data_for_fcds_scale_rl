    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: difficulty-values\n",
        "fx = json.load(open(\"results/forensics.json\"))\n",
        "u = fx[\"uniqueness\"]\n",
        "uniq_name_dob, uniq_lastname_dob, uniq_zip_dob_sex = pct(u[\"unique_name_dob\"]), pct(u[\"unique_lastname_dob\"]), pct(u[\"unique_zip_dob_sex\"])\n",
        "shared_fullname = pct(u[\"share_sharing_full_name\"], 0)\n",
        "bl = fx[\"blocking\"][\"finder_500k.csv\"]\n",
        "n_pairs_naive = f\"{bl['naive_pairs'] / 1e12:.1f} trillion\"\n",
        "pairs_block_dob = f\"{bl['block_dob']['candidate_pairs'] / 1e6:.0f} million\"\n",
        "completeness_block_dob = pct(bl[\"block_dob\"][\"pairs_completeness\"])\n",
        "pairs_block_ln_yob = f\"{bl['block_lastname_initial_yob']['candidate_pairs'] / 1e9:.2f} billion\"\n",
        "completeness_block_ln_yob = pct(bl[\"block_lastname_initial_yob\"][\"pairs_completeness\"])\n",
        "r500_ssn_only_recall = rule(\"ssn_only\", \"recall\")\n",
        "r500_current_either_recall = rule(\"fcds_current_either\", \"recall\")\n",
        "strat = json.load(open(\"results/linkage_baseline_stratified.json\"))[\"finder_files\"][\"finder_500k.csv\"][\"rules\"]\n",
        "def missed(rule_name, group):\n",
        "    return 1 - strat[rule_name][group][\"recall\"]\n",
        "def fm(rule_name, group):\n",
        "    return 1 - strat[rule_name][group][\"precision\"]\n",
        "groups = [\"White\", \"Latino\", \"Black\", \"Asian\", \"Other or unknown\"]\n",
        "nd_missed_min, nd_missed_max = pct(min(missed(\"name_dob\", g) for g in groups)), pct(max(missed(\"name_dob\", g) for g in groups))\n",
        "nd_fm_max = pct(max(fm(\"name_dob\", g) for g in groups), 2)\n",
        "ssn_missed_white, ssn_missed_latino, ssn_missed_asian = (pct(missed(\"ssn_only\", g), 0) for g in (\"White\", \"Latino\", \"Asian\"))\n",
        "best_missed_white, best_missed_asian = pct(missed(\"name_dob_or_ssn\", \"White\")), pct(missed(\"name_dob_or_ssn\", \"Asian\"))\n",
        "lb100 = lb[\"finder_files\"][\"finder_100k.csv\"]\n",
        "rules100 = {r[\"rule\"]: r for r in lb100[\"rules\"]}\n",
        "ladder_100k_max_diff = f\"{100 * max(abs(rules[k]['recall'] - rules100[k]['recall']) for k in rules):.1f}\"\n",
        "baseline_threads = lb[\"node\"][\"duckdb_threads\"]\n",
        "n_rules = len(rules)"
      ],
      "id": "difficulty-values",
      "execution_count": null,
      "outputs": []
    },
