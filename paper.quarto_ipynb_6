    "#| label: author-block\n",
    "#| output: asis\n",
    "# Quarto's docx template prints author names only, so the affiliations, addresses\n",
    "# and corresponding-author email that IJPDS requires are rebuilt here from this\n",
    "# document's own front matter (the YAML above stays the single source of truth).\n",
    "# The block is shown only in the docx; the HTML title block already carries it.\n",
    "import yaml\n",
    "_meta = yaml.safe_load(open(\"paper.qmd\").read().split(\"---\")[1])\n",
    "_lines = [\"**Author affiliations**\", \"\"]\n",
    "for _a in _meta[\"author\"]:\n",
    "    _head = f\"**{_a['name']}**\"\n",
    "    if _a.get(\"corresponding\"):\n",
    "        _head += \" (corresponding author)\"\n",
    "    if _a.get(\"orcid\"):\n",
    "        _head += f\", ORCID {_a['orcid']}\"\n",
    "    _lines.append(\"| \" + _head)  # pandoc line block: one line per address part\n",
    "    for _aff in _a.get(\"affiliations\", []):\n",
    "        _place = \" \".join(p for p in (_aff.get(\"city\"), _aff.get(\"region\"), _aff.get(\"postal-code\")) if p)\n",
    "        _parts = (_aff.get(\"department\"), _aff.get(\"name\"), _aff.get(\"address\"), _place or None, _aff.get(\"country\"))\n",
    "        _lines.append(\"| \" + \", \".join(p for p in _parts if p))\n",
    "    if _a.get(\"email\"):\n",
    "        _lines.append(f\"| Email: {_a['email']}\")\n",
    "    _lines.append(\"\")\n",
    "print(\"\\n\".join(_lines))"
   ]
